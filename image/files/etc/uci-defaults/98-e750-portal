#!/bin/sh
# First-boot portal runtime: 5 GHz AP, br-portal, portal-over-bond, link mode
# and the OLED driver. Non-secret; the STA PSK and BSBF UUID stay external.
set -e

# Portal AP on the calibrated 2.4 GHz radio, sharing it with the STA.
# The 5 GHz QCA9887 is uncalibrated and unstable with a real phone; keep it off.
uci set wireless.radio0.disabled='0'
uci set wireless.radio0.channel='11'
uci set wireless.radio0.htmode='HT20'
uci set wireless.radio0.country='DE'
uci set wireless.radio0.txpower='20'
uci set wireless.default_radio0=wifi-iface
uci set wireless.default_radio0.device='radio0'
uci set wireless.default_radio0.network='portal'
uci set wireless.default_radio0.mode='ap'
uci set wireless.default_radio0.ssid='TollGate-E750'
uci set wireless.default_radio0.encryption='none'
uci set wireless.default_radio0.isolate='1'
uci set wireless.default_radio0.macaddr='02:83:c4:4d:fc:3b'
uci set wireless.default_radio0.disabled='0'
uci set wireless.radio1.disabled='1'
uci -q delete wireless.default_radio1 || true
uci commit wireless

# br-portal at 10.0.0.1, AP only.
uci set network.brportal=device
uci set network.brportal.name='br-portal'
uci set network.brportal.type='bridge'
uci set network.portal=interface
uci set network.portal.proto='static'
uci set network.portal.device='br-portal'
uci set network.portal.ipaddr='10.0.0.1'
uci set network.portal.netmask='255.255.255.0'
uci commit network

uci set dhcp.portal=dhcp
uci set dhcp.portal.interface='portal'
uci set dhcp.portal.start='100'
uci set dhcp.portal.limit='100'
uci set dhcp.portal.leasetime='12h'
uci commit dhcp

uci set firewall.portal=zone
uci set firewall.portal.name='portal'
uci set firewall.portal.network='portal'
uci set firewall.portal.input='REJECT'
uci set firewall.portal.output='ACCEPT'
uci set firewall.portal.forward='REJECT'
uci set firewall.portal_wan=forwarding
uci set firewall.portal_wan.src='portal'
uci set firewall.portal_wan.dest='wan'
uci commit firewall

# nodogsplash + portal uhttpd (if the packages are present).
if [ -x /etc/init.d/nodogsplash ]; then
	uci set nodogsplash.@nodogsplash[0].gatewayinterface='br-portal'
	uci set nodogsplash.@nodogsplash[0].gatewayiprange='10.0.0.0/24'
	uci set nodogsplash.@nodogsplash[0].gatewayaddress='10.0.0.1'
	uci set nodogsplash.@nodogsplash[0].gatewayname='TollGate-E750 · Bonded'
	uci set nodogsplash.@nodogsplash[0].webroot='/etc/nodogsplash/htdocs'
	uci set nodogsplash.@nodogsplash[0].splashpage='splash.html'
	uci -q delete nodogsplash.@nodogsplash[0].authenticated_users || true
	uci add_list nodogsplash.@nodogsplash[0].authenticated_users='allow to 0.0.0.0/0'
	uci commit nodogsplash
	/etc/init.d/nodogsplash enable
fi
if [ -d /etc/tollgate/tollgate-captive-portal-site ]; then
	uci set uhttpd.portal=uhttpd
	uci -q delete uhttpd.portal.listen_http || true
	uci set uhttpd.portal.listen_http='0.0.0.0:2051'
	uci add_list uhttpd.portal.listen_http='[::]:2051'
	uci set uhttpd.portal.home='/etc/tollgate/tollgate-captive-portal-site'
	uci set uhttpd.portal.rfc1918_filter='0'
	uci set uhttpd.portal.no_dirlists='1'
	uci commit uhttpd
	/etc/init.d/uhttpd enable
fi

# CVE-2026-98432 attack-surface knobs.
mkdir -p /etc/sysctl.d
printf 'net.ipv4.tcp_migrate_req=0\nnet.ipv4.tcp_syncookies=1\n' > /etc/sysctl.d/99-cve-2026-98432.conf

# Services and cron.

# One xray process, two inbounds: BSBF keeps 127.0.0.1:12345 and the portal
# redirect listens on 10.0.0.1:12346. Neither service can reset the other.
# The stock init passes both -confdir /etc/xray and -config
# /etc/xray/config.json, which loads the file twice and makes both inbounds
# try to bind the same port. Keep only the explicit conffile.
uci -q delete xray.config.confdir
uci commit xray

if [ -f /etc/xray/config.json ] && command -v jq >/dev/null 2>&1; then
	JQ_BOTH='.inbounds = [
	  {"listen":"127.0.0.1","port":12345,"protocol":"tunnel",
	   "settings":{"network":"tcp,udp","followRedirect":true},
	   "streamSettings":{"sockopt":{"tproxy":"tproxy"}}},
	  {"listen":"10.0.0.1","port":12346,"protocol":"dokodemo-door",
	   "settings":{"network":"tcp","followRedirect":true}}
	]'
	for f in /usr/share/bsbf/xray.json /etc/xray/config.json; do
		[ -f "$f" ] || continue
		[ -f "$f.bak" ] || cp "$f" "$f.bak"
		jq "$JQ_BOTH" "$f" > "$f.new" && mv "$f.new" "$f"
	done
fi

/etc/init.d/e750-portal-tproxy enable
touch /etc/crontabs/root
grep -q e750-link-mode /etc/crontabs/root || \
	echo '* * * * * /usr/bin/e750-link-mode.sh tick >/dev/null 2>&1' >> /etc/crontabs/root
grep -q e750-mcu-oled /etc/crontabs/root || \
	echo '* * * * * /usr/bin/e750-mcu-oled.sh >/dev/null 2>&1' >> /etc/crontabs/root
grep -q 'portal-tproxy.sh --ensure' /etc/crontabs/root || \
	echo '* * * * * /usr/bin/e750-portal-tproxy.sh --ensure >/dev/null 2>&1' >> /etc/crontabs/root
/etc/init.d/cron enable

exit 0
